    "paths": {
        "/v1/data/addAgentProfile": {
            "post": {
                "description": "Registers new emotion while returning a context id in the result",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "example"
                ],
                "summary": "Registers new emotion while returning a context id in the result",
                "parameters": [
                    {
                        "description": "Query parameters",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/emotionapi.NewContextQuery"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/v1/data/getAgentProfile": {
            "post": {
                "description": "Searches profile for agent",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "example"
                ],
                "summary": "Searches profile for agent",
                "parameters": [
                    {
                        "description": "Query parameters",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dataapi.SearchAgentProfileQuery"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/v1/utils/health": {
            "get": {
                "description": "check health",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "example"
                ],
                "summary": "Checks health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dataapi.NewAgentProfileQuery": {
            "type": "object",
            "properties": {
                "agreeableness": {
                    "type": "number"
                },
                "conscientiousness": {
                    "type": "number"
                },
                "context_life_time_in_days": {
                    "type": "integer"
                },
                "extraversion": {
                    "type": "number"
                },
                "is_context_infinite": {
                    "type": "boolean"
                },
                "neuroticism": {
                    "type": "number"
                },
                "openness": {
                    "type": "number"
                }
            }
        },
        "dataapi.SearchAgentProfileQuery": {
            "type": "object",
            "properties": {
                "apikey": {
                    "type": "string"
                }
            }
        },
        "emotionapi.NewContextQuery": {
            "type": "object",
            "properties": {
                "api_key": {
                    "type": "string"
                }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        }
    }
